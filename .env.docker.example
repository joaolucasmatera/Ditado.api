ASPNETCORE_ENVIRONMENT=Production
API_PORT=5031
FRONTEND_PORT=5173
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=ditado
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=preencha-com-a-senha-do-mysql
JWT_SECRET=troque-por-uma-chave-com-no-minimo-32-caracteres
