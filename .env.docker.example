LLM_ENABLED=false
LLM_TIMEOUT_SECONDS=15
LLM_MAX_INPUT_CHARACTERS=8000
LLM_MAX_OUTPUT_TOKENS=768
LLM_CHAIN_0_PROVIDER=Groq
LLM_CHAIN_0_MODEL=preencha-o-modelo
LLM_CHAIN_1_PROVIDER=Cohere
LLM_CHAIN_1_MODEL=preencha-o-modelo
LLM_CHAIN_2_PROVIDER=OpenRouter
LLM_CHAIN_2_MODEL=preencha/fornecedor-modelo
GROQ_API_KEY=preencha-no-servidor
